# Postgres connection string used by Drizzle and the app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multi_agent_demo

# Anthropic API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Model used for every pipeline stage. Haiku 4.5 is the cheapest current model.
ANTHROPIC_MODEL=claude-haiku-4-5
